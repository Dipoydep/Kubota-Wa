rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signed();
      allow write: if signed() && request.auth.uid == uid;
    }
    match /gamertags/{tag} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
    }
    match /ids/{pid} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
    }
    match /codes/{code} {
      allow read: if signed();
      allow create: if signed();
    }
    match /requests/{id} {
      allow read: if signed() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signed() && request.resource.data.from == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if signed() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
    match /chats/{id} {
      allow read: if signed() && request.auth.uid in resource.data.members;
      allow create: if signed() && request.auth.uid in request.resource.data.members;
      allow update: if signed() && (
        request.auth.uid in resource.data.members ||
        (resource.data.type == 'group'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members)
      );
      match /messages/{m} {
        allow read: if signed() && request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.members;
        allow create: if signed() && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.members;
      }
    }
  }
}
